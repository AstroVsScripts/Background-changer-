javascript:(function(){function k(w){try{w.document.querySelectorAll('video,audio').forEach(m=>{m.muted=true;m.pause();m.currentTime=m.duration;m.dispatchEvent(new Event('ended'));m.volume=0;});if(w.activitySteps){w.activitySteps=w.activitySteps.map(()=>'complete');}w.document.querySelectorAll('.next-button,.btn-next,#next,.continue-button,button.forward-arrow').forEach(b=>{b.disabled=false;b.classList.remove('disabled');b.style.pointerEvents='auto';b.click();});}catch(e){}for(let i=0;i<w.frames.length;i++)k(w.frames[i])}k(window);})();
